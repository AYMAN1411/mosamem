{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mosamem",
  "version": "0.1.0",
  "identifier": "app.mosamem.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "مصمم — Mosamem",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "public.app-category.graphics-design",
    "shortDescription": "An Arabic-first image editor — محرر صور عربي أولًا",
    "longDescription": "Mosamem (مصمم) is a free, open-source, Arabic-first image editor: layers, masks, adjustment layers, filters, Arabic text, layer styles, PSD, and local AI that runs on your computer.",
    "copyright": "© 2026 Mosamem contributors. GPL-3.0-or-later.",
    "license": "GPL-3.0-or-later",
    "macOS": {
      "frameworks": [
        "frameworks/libwebgpu_dawn.dylib"
      ],
      "minimumSystemVersion": "13.4"
    }
  }
}
